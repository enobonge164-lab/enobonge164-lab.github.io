function websiteMakeHtmlSafer(html, request) {
  let out = String(html || "").trim();

  if (!out || !/<html[\s>]/i.test(out) || !/<body[\s>]/i.test(out)) {
    return websiteFallbackHtml(request);
  }

  // Remove linked CSS and JavaScript files that may be missing.
  out = out.replace(
    /<link\b(?=[^>]*\brel\s*=\s*["']?stylesheet)[^>]*>/gi,
    ""
  );

  out = out.replace(
    /<script\b(?=[^>]*\bsrc\s*=)[^>]*>\s*<\/script>/gi,
    ""
  );

  // Convert common website routes to links within the downloaded page.
  out = out.replace(
    /href\s*=\s*(["'])\/(about|services|products|portfolio|contact|home)\/?\1/gi,
    (_, q, p) =>
      `href="#${p.toLowerCase() === "products" ? "services" : p.toLowerCase()}"`
  );

  out = out.replace(
    /href\s*=\s*(["'])\/\1/gi,
    'href="#home"'
  );

  // Replace missing local image files with visible placeholders.
  out = out.replace(
    /<img\b([^>]*?)\bsrc\s*=\s*(["'])(?!https?:|data:|blob:)[^"']+\2([^>]*)>/gi,
    '<div class="image-placeholder" role="img" aria-label="Image placeholder">Add your image here</div>'
  );

  // Add responsive safety styles.
  if (/<\/style>/i.test(out)) {
    out = out.replace(
      /<\/style>/i,
      '.image-placeholder{min-height:120px;display:grid;place-items:center;padding:16px;background:#eef2f7;color:#475569;border:1px dashed #94a3b8;border-radius:12px;text-align:center}*,*::before,*::after{box-sizing:border-box}img,video,iframe{max-width:100%}body{overflow-wrap:anywhere}@media(max-width:640px){nav{flex-wrap:wrap}button,a{touch-action:manipulation}} </style>'
    );
  }

  // Ensure mobile viewport metadata exists.
  if (!/<meta[^>]+name=["']viewport["']/i.test(out)) {
    out = out.replace(
      /<head([^>]*)>/i,
      '<head$1><meta name="viewport" content="width=device-width,initial-scale=1">'
    );
  }

  const name = websiteInferName(request.idea);

  if (name && name !== "My Business" && name.length <= 100) {
    out = out.replace(/\[BUSINESS NAME\]/gi, websiteEscapeHtml(name));
  }

  return out;
}
