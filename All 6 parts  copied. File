async function generateWebsiteBuilder(env, body) {
  const request = websiteRequestFromBody(body);

  if (!request.idea) {
    throw new Error("Website idea is required.");
  }

  const instruction = `You generate a WEBSITE HTML FILE that users download and open directly in Chrome, including on Android. Return valid JSON with exactly these keys: project,sitemap,pages,architecture,components,features,mvpFeatures,futureFeatures,dataModel,forms,responsive,seo,accessibility,security,starterHtml,buildPrompt,assumptions,nextSteps. Each page object has name,path,purpose,sections,primaryCTA,notes.

MANDATORY starterHtml requirements:
- Provide a complete document from <!doctype html> through </html>.
- Embed all CSS in <style> and all required JavaScript in inline <script>.
- Do not link styles.css, app.js, other local files, CDNs, libraries, remote fonts, or remote images.
- Use CSS placeholders or inline SVG for visuals.
- Use only in-page links like #home and #contact, never server paths like /about.
- Use the supplied business name consistently and never output [BUSINESS NAME] when a name is present.
- Make all visible buttons work.
- Do not show cart, booking, or payment controls unless implemented.
- Forms validate fields and explicitly state if no backend saves data.
- Never claim a submission was sent or stored when it was not.
- Include mobile-first CSS and viewport metadata, accessible labels, visible focus, readable contrast, and no horizontal overflow at 320px.
- Close all tags and ensure requested sections appear.
- Do not use broken asset paths.
- Keep starterHtml below 25000 characters.
- Do not invent phone numbers, addresses, reviews, credentials, or working integrations.

BRIEF:
Idea=${request.idea};
Audience=${request.targetAudience || "Not specified"};
Type=${request.websiteType};
Style=${request.style};
Pages=${request.pages || "Not specified"};
Features=${request.features || "Not specified"};
Brand=${request.brand || "Not specified"};
Extra=${request.extra || "Not specified"}.

starterHtml is the complete standalone website, not an explanation. buildPrompt contains implementation, API, security, SEO, and acceptance criteria.`;

  let normalized;

  try {
    const aiResponse = await runAI(
      env,
      NEW_TOOL_PROMPTS["website-builder"],
      instruction,
      8192,
      MODELS.CODE
    );

    const raw = cleanResult(extractText(aiResponse));
    const parsed = extractJsonObject(raw);

    if (!parsed) {
      normalized = websiteFallbackResult(
        request,
        "Model output was not valid JSON; a standalone fallback website was generated."
      );
    } else {
      normalized = normalizeWebsiteResult(parsed, request);

      if (
        !normalized.starterHtml ||
        !/<html[\s>]/i.test(normalized.starterHtml) ||
        !/<body[\s>]/i.test(normalized.starterHtml)
      ) {
        normalized = websiteFallbackResult(
          request,
          "Model output did not contain a complete HTML document; a standalone fallback website was generated."
        );
      }
    }
  } catch (error) {
    normalized = websiteFallbackResult(
      request,
      `Website model request failed; standalone fallback generated. ${
        cleanText(error && error.message || "Unknown error", 250)
      }`
    );
  }

  const summary = [
    `Website: ${normalized.project.name}`,
    `Type: ${normalized.project.websiteType}`,
    `Pages: ${
      normalized.pages.map(p => `${p.name} (${p.path})`).join(", ") ||
      "See HTML starter"
    }`,
    `Stack: ${normalized.architecture.stack}`,
    `MVP: ${normalized.mvpFeatures.join("; ") || "Review generated HTML"}`,
    `Next: ${
      normalized.nextSteps.join("; ") ||
      "Review and test the website."
    }`
  ].join("\n");

  return {
    success: true,
    version: API_VERSION,
    type: "website-builder",
    model: MODELS.CODE,
    provider: "cloudflare-workers-ai",
    billingPath: "standard-workers-ai",
    state: "Completed",
    project: normalized.project,
    website: normalized,
    result: summary,
    output: normalized,
    text: summary,
    htmlStarter: normalized.starterHtml,
    buildPrompt: normalized.buildPrompt
  };
}
